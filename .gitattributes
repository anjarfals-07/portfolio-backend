# ============================================================
# GIT ATTRIBUTES
# ============================================================

# ===== Default: auto-detect text files =====
* text=auto

# ===== Shell scripts — LF (untuk Linux/Mac/Docker) =====
*.sh text eol=lf
mvnw text eol=lf
*.bash text eol=lf

# ===== Windows scripts — CRLF =====
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# ===== Config files — LF =====
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.xml text eol=lf

# ===== Markdown — LF =====
*.md text eol=lf

# ===== Java — LF =====
*.java text eol=lf

# ===== TypeScript/JavaScript — LF =====
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# ===== CSS — LF =====
*.css text eol=lf
*.scss text eol=lf

# ===== HTML — LF =====
*.html text eol=lf

# ===== Binary files — JANGAN di-convert =====
*.jar binary
*.war binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# ===== Ignore file di linguist =====
*.min.js linguist-generated=true
*.min.css linguist-generated=true