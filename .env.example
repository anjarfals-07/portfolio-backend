# ============================================================
# PORTFOLIO BACKEND — ENV TEMPLATE
# ============================================================
# Copy file ini ke:
#   - .env  (untuk development)
#   - Set manual di Render/Railway (untuk production)
#
# ⚠️ JANGAN isi value asli di file ini — hanya placeholder!
# ============================================================

# ============================================================
# SPRING PROFILE
# ============================================================
SPRING_PROFILES_ACTIVE=dev

# ============================================================
# DATABASE (Neon PostgreSQL)
# ============================================================
# Format: jdbc:postgresql://<host>/<database>?sslmode=require&channel_binding=require
DATABASE_URL=jdbc:postgresql://ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/portfolio?sslmode=require&channel_binding=require
DATABASE_USERNAME=your-db-username
DATABASE_PASSWORD=your-db-password

# ============================================================
# SERVER
# ============================================================
# Dev: 8080
# Render: 10000
SERVER_PORT=8080

# ============================================================
# FRONTEND / APP URL
# ============================================================
# Dev:     http://localhost:5173 | http://localhost:8080
# Prod:    https://your-frontend.vercel.app | https://your-backend.onrender.com
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:8080

# ============================================================
# JWT
# ============================================================
# Generate: openssl rand -base64 48
# Minimal 32 characters — JANGAN pakai 'zzzzzz'
JWT_SECRET=your-random-32-chars-minimum-here

# ============================================================
# CORS
# ============================================================
# Dev:  http://localhost:5173
# Prod: https://your-frontend.vercel.app (tanpa trailing slash!)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# MAIL (Gmail SMTP)
# ============================================================
# MAIL_PASSWORD: Gmail App Password (bukan password asli)
# Setup: myaccount.google.com → Security → App passwords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_EMAIL=your-email@gmail.com
MAIL_FROM_NAME=Portfolio
MAIL_ADMIN_EMAIL=your-email@gmail.com

# ============================================================
# UPLOAD
# ============================================================
# Dev:    uploads
# Render: /tmp/uploads (ephemeral)
UPLOAD_DIR=uploads

# ============================================================
# BACKUP
# ============================================================
# Dev:  true
# Render free: false (tidak support Docker container)
BACKUP_ENABLED=true
BACKUP_TEMP_DIR=backups
BACKUP_TIMEOUT=300
BACKUP_CLEANUP_DELAY=60

# ============================================================
# LOGGING
# ============================================================
# Dev:    logs/portfolio-app.log
# Render: /tmp/logs/portfolio-app.log
LOG_FILE=logs/portfolio-app.log

# ============================================================
# CLOUDINARY
# ============================================================
# Dashboard: cloudinary.com → Settings → Account
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# CUSTOM DOMAIN
# ============================================================
# Dev:    localhost
# Prod:   your-backend.onrender.com atau app.yourdomain.com
CUSTOM_DOMAIN_CNAME=localhost
CUSTOM_DOMAIN_SERVER_IP=

# ============================================================
# JAVA OPTIONS (Production only)
# ============================================================
# Render free tier: 512 MB RAM
# Uncomment untuk production:
# JAVA_OPTS=-Xmx400m -Xms256m